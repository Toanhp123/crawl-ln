{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-tool.local/schemas/v3-release-acceptance.schema.json",
  "title": "Novel Tool V3 Release Acceptance",
  "type": "object",
  "required": [
    "formatVersion",
    "commit",
    "canonicalCandidateSha256",
    "approvedBy",
    "approvedAt",
    "legacyRemovalApproved"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "canonicalCandidateSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    },
    "legacyRemovalApproved": {
      "const": true
    }
  },
  "additionalProperties": false
}
