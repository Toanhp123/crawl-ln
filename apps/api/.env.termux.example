PORT=3000
STORAGE_DIR=./storage

# Safe E2E defaults for Android/Termux.
MAX_CHAPTERS_PER_RUN=5
CRAWLER_CONCURRENCY=1
CRAWLER_RETRY=2
CRAWLER_DELAY_MS=1200
REQUEST_TIMEOUT_MS=20000
MIN_CHAPTER_CONTENT_CHARS=200

# Keep generic crawling disabled. Use explicit source profiles only.
GENERIC_HTML_ADAPTER_ENABLED=false
SOURCE_ALLOWLIST=novelcool.com,www.novelcool.com
SOURCE_PROFILES_FILE=./config/source-profiles.json
