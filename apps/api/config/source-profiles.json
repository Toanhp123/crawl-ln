[
  {
    "id": "novelcool",
    "name": "NovelCool",
    "enabled": true,
    "chapterListOrder": "newest-first",
    "hosts": ["www.novelcool.com", "novelcool.com"],
    "selectors": {
      "title": ["h1.bookinfo-title", "[itemprop='name']", "h1"],
      "author": [".bookinfo-author", "[itemprop='author']", ".author"],
      "cover": [".bookinfo-pic img", "img[itemprop='image']"],
      "description": [".book-summary", ".bookinfo-summary", "[itemprop='description']"],
      "chapterLinks": [
        ".chapter-item > a[href*='/chapter/']",
        ".chapter-item a[href*='/chapter/']",
        "a[href*='/chapter/Chapter-']"
      ],
      "chapterTitle": [".chapter-item-headtitle", "h2.chapter-title", ".chapter-title", "h1"],
      "chapterContent": [
        ".chapter-reading-section",
        ".chapter-reading-section-list .chapter-reading-section",
        ".overflow-hidden:has(.chapter-start-mark)",
        ".chapter-content",
        "#chapter-content"
      ],
      "remove": [
        "script",
        "style",
        "iframe",
        "ins",
        ".ads",
        ".advertisement",
        ".chapter-start-mark",
        ".chapter-reading-pagination",
        ".reader-side-tool",
        ".read-tool",
        ".chapter-title"
      ]
    },
    "http": {
      "headers": {
        "Accept-Language": "en-US,en;q=0.9"
      },
      "timeoutMs": 20000
    },
    "crawlPolicy": {
      "respectRobotsTxt": true,
      "crawlDelayMs": 1200,
      "maxChaptersPerRun": 5
    }
  }
]
