PORT=3000
STORAGE_DIR=./storage

MAX_CHAPTERS_PER_RUN=5
CRAWLER_CONCURRENCY=1
CRAWLER_RETRY=2
CRAWLER_DELAY_MS=1200
REQUEST_TIMEOUT_MS=20000
MAX_HTTP_RESPONSE_BYTES=20971520
CRAWLER_RETRY_BASE_DELAY_MS=1000
CRAWLER_RETRY_MAX_DELAY_MS=15000
MAX_EXPORT_SOURCE_BYTES=134217728
MIN_CHAPTER_CONTENT_CHARS=200

# Comma-separated hosts that the crawler may access.
SOURCE_ALLOWLIST=novelcool.com,www.novelcool.com

# Replace development defaults in production.
SOURCE_READER_CURSOR_KEY=replace-with-a-private-key
SOURCE_READER_MEMORY_CACHE_ENTRIES=500
# Base64 for exactly 32 bytes; required for credentials/sessions/proxy secrets.
# SOURCE_READER_MASTER_KEY=
# SOURCE_READER_BROWSER_EXECUTABLE=/usr/bin/chromium
SOURCE_READER_NETWORK_DIAGNOSTIC_URL=https://example.com/
SOURCE_READER_EXTERNAL_PROCESS_START_TIMEOUT_MS=10000
SOURCE_READER_PLUGIN_POLICY_VIOLATION_THRESHOLD=3
# SOURCE_READER_PLUGIN_DIR=./storage/source-plugins
# SOURCE_READER_TRUSTED_KEYS_JSON=[]
# SOURCE_READER_DEFAULT_ROLES_JSON=["reader","source-manager","source-admin","system-admin"]
SOURCE_READER_TRUST_ROLE_HEADERS=false
