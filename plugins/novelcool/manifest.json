{
  "id": "novelcool",
  "name": "NovelCool",
  "version": "2.0.0",
  "description": "First-party external source plugin for NovelCool",
  "engines": {
    "sourceReader": "^3.0.0"
  },
  "capabilities": ["identify", "metadata", "chapter-list", "chapter-content"],
  "contracts": {
    "identify": 1,
    "metadata": 1,
    "chapter-list": 1,
    "chapter-content": 1
  },
  "matchers": [
    {
      "hosts": ["novelcool.com"],
      "include": ["/novel/**", "/chapter/**"],
      "exclude": ["/account/**", "/login/**"],
      "priority": 100
    }
  ],
  "runtime": {
    "preferredMode": "isolated"
  },
  "permissions": {
    "network": {
      "hosts": ["novelcool.com", "*.novelcool.com"]
    }
  }
}
