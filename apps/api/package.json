{
  "name": "@novel-tool/api",
  "version": "2.9.6",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --watch --import tsx src/main.ts",
    "build": "cd ../.. && npm run build -w @novel-tool/shared && cd apps/api && tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/main.js",
    "check": "cd ../.. && npm run check -w @novel-tool/shared && cd apps/api && tsc -p tsconfig.json --noEmit",
    "db:reset": "node scripts/reset-db.mjs"
  },
  "dependencies": {
    "@novel-tool/shared": "file:../../packages/shared",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "playwright-core": "^1.61.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
